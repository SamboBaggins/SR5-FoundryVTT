<div class="chummer-import">
  <!-- Import Source Tabs -->
  <div class="import-source-tabs">
    <button type="button" class="import-tab active" data-source="chummer">Chummer</button>
    <button type="button" class="import-tab" data-source="herolabs">Hero Labs</button>
  </div>

  <!-- Chummer Import Section -->
  <div id="chummer-section" class="import-section active">
    <label for="chummer-input">Chummer Export Data (JSON)</label>
    <textarea
      id="chummer-input"
      rows="8"
      placeholder="HOW TO IMPORT:
• In Chummer, go to File > Export, choose JSON format.
• Select all text (CTRL+A) and copy (CTRL+C).
• Paste the copied text into this box."
    ></textarea>
    <div id="chummer-issues" style="display: none;"></div>
  </div>

  <!-- Hero Labs Import Section -->
  <div id="herolabs-section" class="import-section" style="display: none;">
    <label for="herolabs-file-input">Hero Labs Character File</label>
    <div class="file-upload-area" id="herolabs-file-drop">
      <input type="file" id="herolabs-file-input" accept=".por,.xml,.json,application/xml,text/xml,application/json,*/*" style="display: none;" />
      <div class="file-upload-prompt">
        <i class="fas fa-cloud-upload-alt"></i>
        <p>Drag & drop a .por or .xml file here, or click to browse</p>
        <p class="notes">If the file picker doesn't show .por/.xml: open your file in Notepad, copy all (Ctrl+A, Ctrl+C), and paste in the box below.</p>
        <button type="button" class="browse-button">Browse Files</button>
      </div>
      <div class="file-upload-info" id="herolabs-file-info" style="display: none;">
        <span id="herolabs-file-name"></span>
        <button type="button" class="remove-file" id="herolabs-remove-file">×</button>
      </div>
    </div>
    <div class="or-divider">OR</div>
    <p class="notes">Paste XML or JSON here (e.g. open your .por or .xml in Notepad, Ctrl+A, Ctrl+C, then paste below).</p>
    <button type="button" class="load-example-button"><i class="fas fa-user-plus"></i> Load example character (XML)</button>
    <label for="herolabs-input">Hero Labs Export Data (JSON or XML)</label>
    <textarea
      id="herolabs-input"
      rows="8"
      placeholder="HOW TO IMPORT:
• Upload a .por or .xml file above, or paste XML/JSON here.
• Hero Lab XML export or .por (portfolio) file content.
• For JSON: copy from Hero Labs JSON export and paste."
    ></textarea>
    <div id="herolabs-issues" style="display: none;"></div>
  </div>

  <fieldset>
    <legend>Import Options</legend>
    <p>Select the data you wish to import from the file.</p>
    <div class="options-grid">
        <label><input type="checkbox" data-field="armor" checked /> Armors</label>
        <label><input type="checkbox" data-field="contacts" checked /> Contacts</label>
        <label><input type="checkbox" data-field="cyberware" checked /> Cyberware</label>
        <label><input type="checkbox" data-field="gear" checked /> Equipment</label>
        <label><input type="checkbox" data-field="lifestyles" checked /> Lifestyles</label>
        <label><input type="checkbox" data-field="powers" checked /> Powers</label>
        <label><input type="checkbox" data-field="qualities" checked /> Qualities</label>
        <label><input type="checkbox" data-field="spells" checked /> Spells</label>
        <label><input type="checkbox" data-field="vehicles" checked /> Vehicles</label>
        <label><input type="checkbox" data-field="weapons" checked /> Weapons</label>
    </div>
  </fieldset>

  <fieldset>
    <legend>Settings</legend>
    <div class="import-settings">
      <div class="options-grid">
        <label><input type="checkbox" id="assign-icons" checked /> Automatically assign icons</label>
      </div>

      <button type="button" data-action="openConfig" class="configure-button">
        <i class="fas fa-cogs"></i> Configure Compendium Sources
      </button>
    </div>
  </fieldset>

  <div class="import-actions">
    <label for="chummer-folder-select">Import to folder:</label>
    <select id="chummer-folder-select">
        <option value=""></option>
        {{#each folders as |folder|}}
            <option value="{{folder.id}}">{{folder.name}}</option>
        {{/each}}
    </select>
    <button type="button" data-action="import">Import Character</button>
  </div>
</div>
